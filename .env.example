# Tagging providers, server-side only. Never prefix with VITE_ or they ship to the browser.
# Both are optional: with neither set, the browser's offline tagger tags every memory.
# If both are set, Claude is used.
# Copy to .env or .env.local and fill in: cp .env.example .env.local
# Get a free Groq key from https://console.groq.com/keys
ANTHROPIC_API_KEY=
GROQ_API_KEY=
